# Copy to .env and fill in. Never commit .env.
DEBUG=1
# Required when DEBUG=0. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Pepper for hashing UPI reference numbers. Set once per environment and never change it.
REF_HASH_PEPPER=
DATABASE_URL=postgis://forreal:forreal@localhost:5432/forreal
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
# Dotted path to the class that sends OTP SMS. The default only logs the code.
OTP_SENDER=apps.accounts.otp.ConsoleOtpSender
# Returns the OTP in the API response. Keep 0 anywhere real users sign in.
OTP_ECHO_IN_RESPONSE=1
