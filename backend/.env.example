# Copy to .env and fill in. Never commit .env.
DEBUG=1
# Required when DEBUG=0. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Pepper for hashing UPI reference numbers. Set once per environment and never change it.
REF_HASH_PEPPER=
DATABASE_URL=postgis://forreal:forreal@localhost:5432/forreal
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
# Dotted path to the class that sends OTP SMS. The default only logs the code.
OTP_SENDER=apps.accounts.otp.ConsoleOtpSender
# Returns the OTP in the API response. Keep 0 anywhere real users sign in.
OTP_ECHO_IN_RESPONSE=1
# Closed testing only: comma-separated E.164 numbers, at most 10. While set, only these
# numbers can sign in and the code is returned in the response instead of sent by SMS.
# Leave empty otherwise. See DEPLOY.md.
TESTER_PHONES=
# Dotted path to the reverse geocoder that names new localities.
# Use apps.geo.geocoding.NullGeocoder to switch geocoding off.
GEOCODER_BACKEND=apps.geo.geocoding.NominatimGeocoder
# Point this at a self-hosted Nominatim to lift the public service's limits.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Required by the Nominatim usage policy: app name and a contact, e.g. ForReal/0.1 (you@example.com).
# No geocoding request is sent while this is empty.
NOMINATIM_USER_AGENT=
# For the future Google adapter. Unused for now.
GOOGLE_MAPS_API_KEY=
