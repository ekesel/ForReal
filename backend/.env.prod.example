# Production settings for docker-compose.prod.yml. See DEPLOY.md.
#   cp .env.prod.example .env && chmod 600 .env
# Never commit .env. Generate the three secrets on the server; never reuse the dev values.

# --- Host ------------------------------------------------------------------
# Public host name. Caddy gets the HTTPS certificate for it.
DOMAIN=api.example.com
# Host names Django answers to, comma-separated. Normally the same as DOMAIN.
ALLOWED_HOSTS=api.example.com
# Origins allowed to post forms (the admin). Scheme and host, comma-separated.
CSRF_TRUSTED_ORIGINS=https://api.example.com
# URL prefix of the Django admin. Pick something that is not "admin/".
ADMIN_PATH=change-me-console/

# --- Core ------------------------------------------------------------------
# Must be 0. With 0 the process refuses to start if anything below is missing or unsafe.
DEBUG=0
# At least 50 characters. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Pepper for hashing UPI reference numbers. Must differ from SECRET_KEY.
# Set once and NEVER change it: changing it breaks de-duplication of stored payments.
# Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
REF_HASH_PEPPER=
# Password of the "forreal" database user. Hex only, so it is safe inside a URL.
# Used when the database volume is first created; changing it later does not change the database.
# Generate:
#   openssl rand -hex 32
POSTGRES_PASSWORD=
# DATABASE_URL, REDIS_URL and STATIC_ROOT are set by docker-compose.prod.yml. Do not set them here.
# How long browsers remember to use HTTPS only, in seconds. One year by default.
#SECURE_HSTS_SECONDS=31536000

# --- Sign-in ---------------------------------------------------------------
# Closed testing: comma-separated E.164 numbers, at most 10. Only these numbers can sign in,
# and the code is returned in the response instead of sent by SMS. See "Closed testing" in
# DEPLOY.md. Before any wider release: configure a real sender below and empty this.
TESTER_PHONES=
# Dotted path to the class that sends the code by SMS. The console sender only logs, and is
# accepted with DEBUG=0 only while TESTER_PHONES is set.
OTP_SENDER=apps.accounts.otp.ConsoleOtpSender
# Returns the code in the response. Keep 0: closed testing echoes to listed numbers by itself,
# and 1 without TESTER_PHONES stops the process from starting.
OTP_ECHO_IN_RESPONSE=0
# Sign-in requests allowed per IP address.
#OTP_IP_THROTTLE=30/hour

# --- Geocoding -------------------------------------------------------------
# Names new localities. apps.geo.geocoding.NullGeocoder switches it off.
GEOCODER_BACKEND=apps.geo.geocoding.NominatimGeocoder
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Required by the Nominatim usage policy: app name and a real contact.
# No geocoding request is sent while this is empty.
NOMINATIM_USER_AGENT="ForReal/0.1 (you@example.com)"
